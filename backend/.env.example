# Voice answers. Every value is optional; defaults shown.
# Load with:  uvicorn app.main:app --reload --env-file .env
# Never commit a real .env file.

# Largest audio upload accepted, in bytes (default 10 MB).
MAX_AUDIO_UPLOAD_BYTES=10485760

# Longest accepted recording, in seconds.
MAX_RECORDING_SECONDS=60

# Seconds to wait for transcription before returning a timeout error.
TRANSCRIPTION_TIMEOUT_SECONDS=60

# faster-whisper model (downloaded on first use; needs requirements-whisper.txt).
WHISPER_MODEL_SIZE=base.en