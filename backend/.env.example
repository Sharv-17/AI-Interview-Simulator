# AI Interview Simulator: configuration. Every value is optional unless noted.
# Load with:  uvicorn app.main:app --reload --env-file .env
# Never commit a real .env file or real keys.


# ---- Storage ------------------------------------------------------------------
# Supported backends: memory, postgres
#
# Memory: development/testing only. Data is lost when the application restarts.
STORAGE_BACKEND=memory
#
# PostgreSQL: persistent storage (recommended for the Neon deployment).
# Uncomment and configure DATABASE_URL when using PostgreSQL.
# For local PostgreSQL:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/interview_sim
#
# For Neon, use your Neon connection string in backend/.env (never commit it).
# Run database migrations from the backend directory:
# alembic upgrade head


# ---- AI answer evaluation -------------------------------------------------------
# Without a provider, answers are SAVED but not scored (evaluation_status "pending").
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# LLM_PROVIDER=openai_compatible
# OPENAI_API_KEY=
# OPENAI_MODEL=
# OPENAI_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=30
LLM_MAX_ATTEMPTS=3
MAX_EVALUATION_RETRIES=5

# ---- Timing and integrity ------------------------------------------------------
# Time limit per question = its estimated_time_seconds; answers are accepted until limit + grace.
ANSWER_GRACE_SECONDS=15
MAX_ANSWER_CHARS=20000
# Typed answers faster than this (characters/second) are flagged as an indicator only.
FAST_SUBMISSION_CHARS_PER_SECOND=25

# ---- Accounts (optional) ----------------------------------------------------------
# Guest interviews work without any of this. Sessions are opaque random tokens in an
# HttpOnly cookie; only their SHA-256 hash is stored in PostgreSQL (users/auth_sessions).
# See docs/AUTHENTICATION.md.
#
# Secure cookies need HTTPS. Set to false ONLY for plain-HTTP local development.
AUTH_COOKIE_SECURE=true
AUTH_SESSION_TTL_SECONDS=604800
# AUTH_SESSION_COOKIE_NAME=ais_session
# AUTH_COOKIE_SAMESITE=lax
# AUTH_COOKIE_DOMAIN=
# Extra origins allowed to send cookie-authenticated state-changing requests.
# Empty means same-origin only.
# AUTH_ALLOWED_ORIGINS=https://app.example.com
# AUTH_LOGIN_RATE_LIMIT_ATTEMPTS=10
# AUTH_LOGIN_IP_RATE_LIMIT_ATTEMPTS=50
# AUTH_REGISTER_RATE_LIMIT_ATTEMPTS=20
# Rate limiting uses the socket address; enable only behind a proxy you control.
# AUTH_TRUST_PROXY=false


# ---- Voice answers ---------------------------------------------------------------
MAX_AUDIO_UPLOAD_BYTES=10485760
MAX_RECORDING_SECONDS=60
TRANSCRIPTION_TIMEOUT_SECONDS=60
WHISPER_MODEL_SIZE=base.en
