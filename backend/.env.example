# AI Interview Simulator: configuration. Every value is optional unless noted.
# Load with:  uvicorn app.main:app --reload --env-file .env
# Never commit a real .env file or real keys.

# ---- Storage (REQUIRED: the app refuses to start without one of these) ----------
# Development / tests only: everything is kept in memory and lost on restart.
STORAGE_BACKEND=memory
# PostgreSQL (the intended production store). NOTE: the Postgres store itself is not
# implemented yet in this build; only the schema + Alembic migration exist.
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/interview_sim
# Create the schema with:  alembic upgrade head   (DATABASE_URL must be set)

# ---- AI answer evaluation -------------------------------------------------------
# Without a provider, answers are SAVED but not scored (evaluation_status "pending").
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# LLM_PROVIDER=openai_compatible
# OPENAI_API_KEY=
# OPENAI_MODEL=
# OPENAI_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=30
LLM_MAX_ATTEMPTS=3
MAX_EVALUATION_RETRIES=5

# ---- Timing and integrity ------------------------------------------------------
# Time limit per question = its estimated_time_seconds; answers are accepted until limit + grace.
ANSWER_GRACE_SECONDS=15
MAX_ANSWER_CHARS=20000
# Typed answers faster than this (characters/second) are flagged as an indicator only.
FAST_SUBMISSION_CHARS_PER_SECOND=25

# ---- Voice answers ---------------------------------------------------------------
MAX_AUDIO_UPLOAD_BYTES=10485760
MAX_RECORDING_SECONDS=60
TRANSCRIPTION_TIMEOUT_SECONDS=60
WHISPER_MODEL_SIZE=base.en
